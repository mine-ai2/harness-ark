{
  "server": {
    "host": "${ARK_HOST}",
    "port": ${ARK_PORT},
    "auth_secret": "${ARK_AUTH_SECRET}"
  },
  "providers": {
    "openai": {
      "provider_type": "openai",
      "api_key": "${OPENAI_API_KEY}"
    }
  },
  "tools": {
    "mineai_gateway": {
      "url": "${MINEAI_GATEWAY_URL}",
      "secret": "${MINEAI_GATEWAY_SECRET}"
    }
  },
  "agents": {
    "talos": {
      "provider": "openai",
      "model": "gpt-5-mini"
    }
  }
}
