{
  "server": {
    "host": "${ARK_HOST}",
    "port": ${ARK_PORT},
    "auth_secret": "${ARK_AUTH_SECRET}"
  },
  "providers": {
    "anthropic": {
      "provider_type": "anthropic",
      "api_key": "${ANTHROPIC_API_KEY}"
    }
  },
  "tools": {
    "mineai_gateway": {
      "url": "${MINEAI_GATEWAY_URL}",
      "secret": "${MINEAI_GATEWAY_SECRET}"
    }
  },
  "agents": {
    "talos": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6"
    }
  }
}
