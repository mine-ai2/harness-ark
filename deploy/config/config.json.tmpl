{
  "server": {
    "host": "${ARK_HOST}",
    "port": ${ARK_PORT},
    "auth_secret": "${ARK_AUTH_SECRET}"
  },
  "providers": {
    "openai": {
      "provider_type": "openai",
      "api_key": "${OPENAI_API_KEY}"
    },
    "openrouter": {
      "provider_type": "openrouter",
      "api_key": "${OPENROUTER_API_KEY}"
    }
  },
  "tools": {
    "mineai_gateway": {
      "url": "${MINEAI_GATEWAY_URL}",
      "secret": "${MINEAI_GATEWAY_SECRET}"
    }
  },
  "agents": {
    "talos": {
      "provider": "openrouter",
      "model": "moonshotai/kimi-k3",
      "max_context_tokens": 256000,
      "always_loaded_skills": ["mineai_tools"],
      "max_tokens": 8192,
      "prompt_caching": true,
      "tool_result_keep_turns": 2,
      "tool_result_elide_over": 2048,
      "tool_result_max_bytes": 65536
    }
  }
}
